    <a class="btn-primary" href="https://wa.me/62812xxxxxxx?text=Halo%2C%20saya%20ingin%20konsultasi%20layanan%20Foura%20Creative" target="_blank">Konsultasi via WhatsApp</a>
  </div>
</div>

<script>
  function hitungRekomendasi(){
    const konten = document.getElementById('calc-konten').value;
    let rec;
    if(konten === 'low'){
      rec = { name:'Paket Basic', price:'Rp 500.000', desc:'Cocok untuk kebutuhan konten ringan sambil membangun konsistensi posting di media sosial.' };
    } else if(konten === 'high'){
      rec = { name:'Paket Premium', price:'Rp 2.000.000', desc:'Untuk kebutuhan konten intensif, lengkap dengan sesi foto/video produk dan strategi promo musiman.' };
    } else {
      rec = { name:'Paket Pro', price:'Rp 1.100.000', desc:'Cocok untuk kebutuhan konten menengah di Instagram & TikTok, lengkap dengan laporan dan konsultasi bulanan.' };
    }
    document.getElementById('calc-result-name').textContent = rec.name;
    document.getElementById('calc-result-price').innerHTML = rec.price + '<small>/bulan</small>';
    document.getElementById('calc-result-desc').textContent = rec.desc;

    const pesan = `Halo Foura Creative, saya tertarik dengan ${rec.name} (${rec.price}/bulan). Bisa dijelaskan lebih lanjut?`;
    document.getElementById('calc-wa-btn').href = 'https://wa.me/62812xxxxxxx?text=' + encodeURIComponent(pesan);
  }

  document.addEventListener('DOMContentLoaded', function(){
    const sections = document.querySelectorAll('[data-section]');
    const navLinks = document.querySelectorAll('nav.main a');

    function onScroll(){
      let current = sections[0].dataset.section;
      const scrollPos = window.scrollY + 130;
      sections.forEach(function(sec){
        if (sec.offsetTop <= scrollPos) current = sec.dataset.section;
      });
      navLinks.forEach(function(link){
        link.classList.toggle('active', link.dataset.section === current);
      });
    }

    window.addEventListener('scroll', onScroll);
    onScroll();
  });
</script>

<%- include('partials/footer') %>
</body>
